#!/bin/sh
# The wall's status at login. Install:
#
#   sudo cp deploy/update-motd.d-20-flaschen-taschen \
#           /etc/update-motd.d/20-flaschen-taschen
#   sudo chmod +x /etc/update-motd.d/20-flaschen-taschen
#   sudo chmod -x /etc/update-motd.d/10-uname     # its output is in the banner
#   sudo truncate -s 0 /etc/motd                  # the Debian boilerplate
#
# Deliberately not a program that asks the wall how it is. ftctl already polls
# that once a second and knows when it changed, so it renders the banner then;
# this only prints it. On a Pi 3 the difference is three seconds of every login.
#
# Shell, not Python, for the same reason: the interpreter alone costs more than
# everything this does.

BANNER=/run/ft-motd/banner.ansi
[ -r "$BANNER" ] || exit 0
cat "$BANNER"

# A banner nobody is refreshing is worse than none, because it looks current.
# Five minutes is comfortably past ftctl's one-second poll and its 60-second
# floor for re-rendering, so anything older means the daemon is gone.
if [ -n "$(find "$BANNER" -mmin +5 2>/dev/null)" ]; then
    printf '  \033[38;2;255;92;92m⚠  this status is stale — is ftctl running?\033[0m\n\n'
fi
