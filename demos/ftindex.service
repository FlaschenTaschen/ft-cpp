# The wall's front door: a landing page on :80 pointing at the control panel.
# Install on betelgeuse with:
#
#   sudo cp demos/ftindex.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ftindex.service
#
# And, once HTTPS Certificates are enabled for the tailnet (admin console ->
# DNS -> HTTPS Certificates), the same two pages over TLS on the tailnet only:
#
#   tailscale serve --bg --https=443  http://127.0.0.1:80
#   tailscale serve --bg --https=8443 http://127.0.0.1:8081
#
# Those persist across reboots on their own, so they are not a unit here.

[Unit]
Description=Flaschen Taschen landing page
Documentation=https://github.com/FlaschenTaschen/ft-cpp
After=network-online.target
Wants=network-online.target
# Deliberately not BindsTo=ftsched: if the scheduler is down, this page is the
# thing that says so. It is also what someone reaches for when the wall looks
# wrong, which is exactly when it must not have died alongside it.

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ft-cpp/demos
ExecStart=/usr/bin/python3 /home/pi/ft-cpp/demos/ftindex.py \
    --listen 0.0.0.0:80 \
    --panel-port 8081 --panel-tls-port 8443 \
    --ft-port 1337 --width 320 --height 64

# Ports below 1024 need the capability, not the user: this stays unprivileged
# and gains exactly one thing, the ability to bind :80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Restart=always
RestartSec=3

# It renders one page and shells out to nothing. Give it none of the machine
# it does not use -- this is the process most exposed to the room.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is not for us: it is what glibc reaches for on the way to NSS and
# syslog, and losing it turns an ordinary lookup into an unexplained failure
# in the one service whose whole job is to answer.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
