# The wall's front door: the web app on :80, with ftsched proxied at the root
# and one page of its own at /about. Install on betelgeuse with:
#
#   sudo cp demos/ftindex.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ftindex.service
#
# And, for the same thing over TLS to the tailnet only:
#
#   tailscale serve --bg --https=443 http://127.0.0.1:80
#
# One line, because everything is behind one port now: the panel, the API, the
# previews and /about are all the same origin, so there is nothing left that
# needs a second certificate or a second rule. It persists across reboots on
# its own, so it is not a unit here.
#
# ftsched's own --listen stays on 8081 bound to 0.0.0.0 for now. Binding it to
# 127.0.0.1 would make this the only way in, which is tidier; it is left
# reachable so there is a way to drive the wall if this daemon is the thing
# that is broken.

[Unit]
Description=Flaschen Taschen web front door
Documentation=https://github.com/FlaschenTaschen/ft-cpp
After=network-online.target
Wants=network-online.target
# Deliberately not BindsTo=ftsched: if the scheduler is down, this page is the
# thing that says so. It is also what someone reaches for when the wall looks
# wrong, which is exactly when it must not have died alongside it.

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ft-cpp/demos
ExecStart=/usr/bin/python3 /home/pi/ft-cpp/demos/ftindex.py \
    --listen 0.0.0.0:80 --panel-port 8081 \
    --ft-port 1337 --width 320 --height 64

# Ports below 1024 need the capability, not the user: this stays unprivileged
# and gains exactly one thing, the ability to bind :80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Restart=always
RestartSec=3

# It renders one page and shells out to nothing. Give it none of the machine
# it does not use -- this is the process most exposed to the room.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is not for us: it is what glibc reaches for on the way to NSS and
# syslog, and losing it turns an ordinary lookup into an unexplained failure
# in the one service whose whole job is to answer.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
